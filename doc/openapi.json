  "info": {
    "title": "Document Search Platform",
    "description": "Agentic RAG document search backend for OpenWebUI. Ingests PDFs with Docling, indexes them in PostgreSQL/pgvector via LlamaIndex, answers with a CrewAI multi-agent pipeline, traces calls in Arize Phoenix, and evaluates with RAGAs.",
